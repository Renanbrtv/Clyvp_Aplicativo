{
  "name": "clyvo-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "fix": "expo install --fix",
    "build:web": "expo export --platform web",
    "serve:web": "npx serve dist --single",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "submit:android": "eas submit --platform android --profile production",
    "eas-build-post-install": "node scripts/check-release.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "10.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "eas-cli": "^16.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
