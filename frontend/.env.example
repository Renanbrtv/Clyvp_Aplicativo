# ==========================================================
# Clyvo - App (Expo)
# Copie para ".env" se quiser fixar o endereco da API.
#   Windows:  copy .env.example .env
# NUNCA versione o ".env".
#
# Se voce NAO criar este arquivo, o app descobre sozinho o IP do
# seu computador pelo Expo. Isso e o ideal durante o desenvolvimento.
# ==========================================================

# Endereco completo da API, ja com o /api no fim.
# Deixe em branco (ou nao crie o arquivo) para o modo automatico.
#
#   Celular no mesmo Wi-Fi:  http://192.168.0.10:3333/api
#   Emulador Android:        http://10.0.2.2:3333/api
#   Navegador no mesmo PC:   http://localhost:3333/api
EXPO_PUBLIC_API_URL=

# development | preview | production
# So muda textos de aviso; nao altera o comportamento do app.
APP_ENV=development

# Chave PUBLICA Android do RevenueCat (goog_...). Nunca use a chave secreta aqui.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
