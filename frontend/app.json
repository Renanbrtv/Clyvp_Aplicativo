{
  "expo": {
    "name": "Clyvo",
    "slug": "clyvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clyvo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#FF7827",
    "description": "Transforme conversas em vendas. Clientes, oportunidades e propostas no seu bolso.",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.clyvo.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Clyvo",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.clyvo.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7827"
      },
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Clyvo",
      "shortName": "Clyvo",
      "lang": "pt-BR",
      "themeColor": "#FF7827",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait",
      "description": "Transforme conversas em vendas."
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF7827"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
