# ==========================================================
# Clyvo - Backend - PRODUCAO
#
# Copie para ".env" NO SERVIDOR (nunca no seu PC, nunca no Git).
# Em servicos como Railway e Render voce nao cria arquivo: cola
# cada linha destas no painel de "Environment Variables".
#
# A API se recusa a subir se algo aqui ficar com valor de exemplo.
# ==========================================================

# ---------- Aplicacao ----------
NODE_ENV=production
# Railway, Render e Heroku definem a PORT sozinhos. Se o seu servico
# fizer isso, apague a linha abaixo.
PORT=3333
API_PREFIX=/api

# ---------- CORS ----------
# OBRIGATORIO em producao: liste os enderecos do seu site, separados
# por virgula. "*" faz a API se recusar a subir.
# O app Android nao precisa estar nesta lista (aplicativo nativo nao
# passa por CORS) - aqui entram apenas os enderecos do navegador.
CORS_ORIGIN=https://app.clyvo.com.br,https://clyvo.com.br

# ---------- Banco de dados ----------
# Os valores vem do painel do seu provedor de MySQL.
DB_HOST=seu-host-mysql.exemplo.com
DB_PORT=3306
DB_USER=clyvo
DB_PASSWORD=troque-por-uma-senha-forte-de-verdade
DB_NAME=clyvo
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=Z
# Bancos gerenciados exigem conexao criptografada.
DB_SSL=true

# ---------- JWT ----------
# Gere DOIS valores diferentes, um para cada linha:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se voce trocar estes segredos depois, todo mundo e deslogado. E normal.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=clyvo-api

# ---------- Seguranca ----------
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=30
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Em producao segure a mao nas rotas de login: 10 a 20 por janela.
AUTH_RATE_LIMIT_MAX_REQUESTS=12

# ---------- Logs ----------
LOG_LEVEL=info

# ---------- Seeds ----------
# O seed cria a conta de demonstracao. Em producao, use um e-mail seu
# e uma senha forte - ou nao rode o seed (so a migration ja basta).
SEED_USER_EMAIL=voce@seudominio.com.br
SEED_USER_PASSWORD=troque-esta-senha-tambem
SMOKE_TEST_BASE_URL=https://api.clyvo.com.br

# ---------- Integracoes ----------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
AI_PROVIDER=
AI_API_KEY=

# Recuperacao de senha — Resend, remetente com dominio verificado
EMAIL_API_KEY=
EMAIL_FROM=
# Modelo usado quando AI_PROVIDER=openai e AI_API_KEY estiver preenchida
AI_MODEL=gpt-4.1-mini

# Assinaturas: chave secreta RevenueCat, somente no servidor
REVENUECAT_SECRET_KEY=
# Habilite apenas no ambiente de testes de compra
BILLING_ALLOW_SANDBOX=false
