# ==========================================================
# Clyvo - Backend
# Copie este arquivo para ".env" e ajuste os valores.
#   Windows (WAMP):  copy .env.example .env
#   Linux/macOS:     cp .env.example .env
# NUNCA versione o arquivo .env (ele ja esta no .gitignore).
# ==========================================================

# ---------- Aplicacao ----------
NODE_ENV=development
PORT=3333
API_PREFIX=/api

# Origens liberadas no CORS (separadas por virgula).
# "*" libera todas - use apenas em desenvolvimento.
CORS_ORIGIN=*

# ---------- Banco de dados (MySQL / WAMP) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clyvo
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=Z

# ---------- JWT ----------
# Gere segredos fortes e DIFERENTES entre si, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_REFRESH_SECRET=troque-este-outro-valor-por-um-segredo-diferente
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=clyvo-api

# ---------- Seguranca ----------
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_EXPIRES_MINUTES=30
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Limite das rotas de login/cadastro/recuperacao por janela.
# 50 e folgado para desenvolvimento (o "npm run test:api" faz ~17 chamadas).
# Em producao, use algo entre 10 e 20.
AUTH_RATE_LIMIT_MAX_REQUESTS=50

# ---------- Logs ----------
# error | warn | info | debug
LOG_LEVEL=debug

# ---------- Seeds / testes ----------
SEED_USER_EMAIL=renan@clyvo.app
SEED_USER_PASSWORD=Clyvo@2025
SMOKE_TEST_BASE_URL=http://127.0.0.1:3333

# ---------- Integracoes futuras (Etapa 14 / 15) ----------
# Deixe em branco enquanto nao forem implementadas.
AI_PROVIDER=
AI_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# Recuperacao de senha — Resend, remetente com dominio verificado
EMAIL_API_KEY=
EMAIL_FROM=
# Modelo usado quando AI_PROVIDER=openai e AI_API_KEY estiver preenchida
AI_MODEL=gpt-4.1-mini

# Assinaturas: chave secreta RevenueCat, somente no servidor
REVENUECAT_SECRET_KEY=
# Habilite apenas no ambiente de testes de compra
BILLING_ALLOW_SANDBOX=false
