# ==========================================================
# Clyvo - App (Expo) - PRODUCAO
#
# Voce NAO precisa deste arquivo se usar o EAS: os valores de
# producao ja estao no "eas.json", em build.production.env.
#
# Use este arquivo apenas para gerar a versao WEB no seu PC:
#   copy .env.production.example .env.production
#   npm run build:web
# ==========================================================

# Troque pelo endereco real do seu servidor, com https e /api no fim.
EXPO_PUBLIC_API_URL=https://api.clyvo.com.br/api
APP_ENV=production
