+      direction: actor === invite.customer_id ? 'enviado' : 'recebido',
+      counterpartId,
+    };
+  },
+  async shareInviteWhatsapp(actor: number, id: number, enabled: boolean) {
+    return mutateInvite(actor, id, async (invite) => {
